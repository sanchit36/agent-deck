+	require.GreaterOrEqual(t, len(f.lastEvent().Args), 2)
+	assert.Equal(t, []string{"-F", "fixture-config"}, f.lastEvent().Args[:2])
+	assert.Contains(t, f.lastEvent().Args, "git@"+fixtureHost)
